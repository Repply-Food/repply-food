# DESENVOLVIMENTO USA SEMPRE O BANCO LOCAL. Preencha com os valores de `npx supabase status`.
# As chaves da NUVEM nunca ficam no .env.local: guarde-as em .env.nuvem.local (ignorado
# pelo git e não lido pelo Next.js) e use só na publicação, com autorização.
# Nunca exponha a chave de serviço com NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Obrigatória na build/execução de produção. Local: endereço abaixo;
# publicação futura: trocar pelo endereço público real antes da build.
# Ex.: NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000 npm run build
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Função receber-envio no servidor: URL local e chave de serviço, somente no ambiente da função.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
# A URL do site é NEXT_PUBLIC_APP_URL (acima); não há SITE_URL separado.
# Etapa 4 (e-mails de senha): SMTP do Resend, configurado no Supabase na publicação (4b).
RESEND_API_KEY=
# Etapa 9 (alarme do vigia): remetente e destinatário do e-mail de alarme.
ALERTA_EMAIL_DE=
ALERTA_EMAIL_PARA=
# Gerador: use arquivo de teste próprio/ignorado, nunca o token da demonstração.
# Envio real exige --fuso IANA ou SCC_FUSO; dry-run sem fuso declara Fortaleza fictício.
# SCC_FUSO=America/Fortaleza
# SCC_URL=http://127.0.0.1:54321/functions/v1/receber-envio
# SCC_TOKEN=  (não coloque token em arquivo versionado)
