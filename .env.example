# repply food. · variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite valores reais.

# ---------- Supabase (obrigatórias) ----------
# Painel do projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: SÓ no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Usado por `npm run types` (gera types/supabase.ts)
SUPABASE_PROJECT_ID=

# ---------- App ----------
# Endereço público do painel. A build falha em produção sem ele.
# Local: http://localhost:3000 · Produção: https://food.repplyhub.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- E-mail (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM="repply food. <nao-responda@repplyhub.com.br>"

# ---------- Edge Functions (configurar como segredos do Supabase, não aqui) ----------
# RESEND_API_KEY      → enviar-alerta
# ALERTA_EMAIL_PARA   → quem recebe o alarme de "restaurante parado"
# ALERTA_EMAIL_DE     → remetente do alarme
